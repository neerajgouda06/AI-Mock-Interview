# ============================================
# Client Environment Variables (.env.example)
# ============================================
# NOTE: If deploying client + server together on a single Render Web Service,
# you do NOT need to set VITE_API_URL (it defaults to relative /api automatically).
#
# If deploying client as a separate Render Static Site, set this to your Render Backend URL:
# VITE_API_URL=https://your-backend.onrender.com/api

VITE_API_URL=http://localhost:5000/api
