# ============================================
# Server Environment Variables (.env.example)
# ============================================
# Copy this file to .env and fill in your actual credentials.
# On Render: Add these under Environment Variables in your Web Service dashboard.

PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai-mock-interview?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_random_jwt_key_here
JWT_EXPIRES_IN=7d

# Google Gemini API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Murf AI API Key (for Voice generation)
# Get from: https://murf.ai/
MURF_API_KEY=your_murf_api_key_here

# AssemblyAI API Key (for Speech-to-text)
# Get from: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Frontend URL (for CORS if deploying frontend separately)
# For single-service deployment, this is optional.
# For separate services, set to your Render frontend URL (e.g., https://ai-mock-interview.onrender.com)
CLIENT_URL=http://localhost:5173
